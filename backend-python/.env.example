# Environment Configuration for BuddyDoc Backend
# Copy this file to .env and fill in your actual values

# Server
PORT=8000
HOST=0.0.0.0

# Google Cloud Platform (for Vertex AI)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json

# Neo4j Aura (Medical Ontology Graph Database)
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# Firebase Admin (Authentication & Firestore)
FIREBASE_CREDENTIALS=/path/to/firebase-service-account.json
FIREBASE_PROJECT_ID=your-firebase-project-id

# Agent Configuration
AGENT_TIMEOUT_SECONDS=8
ENABLE_LLM_AGENT=false

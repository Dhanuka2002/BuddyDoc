# Example environment variables for BuddyDoc (root)
# Copy to .env and fill values for local development.

# Orchestrator settings
BUDDYDOC_ORCH_SECRET=changeme
BUDDYDOC_CORS_ORIGINS=http://localhost:19006,http://127.0.0.1:19006

# Agents / LLM
USE_OPENAI=0
OPENAI_API_KEY=

# Agent URLs (optional)
BUDDYDOC_AGENT1_URL=http://127.0.0.1:8101/api/v1/respond
BUDDYDOC_AGENT2_URL=http://127.0.0.1:8102/api/v1/respond
